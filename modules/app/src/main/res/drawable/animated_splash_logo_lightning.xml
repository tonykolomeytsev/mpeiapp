<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">

            <!-- Dark background -->
            <path
                android:fillColor="#0A1929"
                android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />

            <!-- Lightning bolt shape (stylized 'M' + lightning) -->
            <group android:name="lightningGroup">
                <!-- Main lightning bolt -->
                <path
                    android:name="bolt"
                    android:fillColor="#FFD700"
                    android:pathData="M60,20 L48,50 L56,50 L44,88 L62,52 L54,52 L60,20 Z" />
                
                <!-- Lightning glow -->
                <path
                    android:fillColor="#FFEB3B"
                    android:fillAlpha="0.6"
                    android:pathData="M59,22 L49,50 L55,50 L46,84 L60,52 L55,52 L59,22 Z" />
            </group>

            <!-- Energy waves emanating from lightning -->
            <group
                android:name="wave1Group"
                android:pivotX="54.0"
                android:pivotY="54.0">
                <path
                    android:strokeColor="#00E5FF"
                    android:strokeWidth="2"
                    android:strokeAlpha="0.8"
                    android:fillColor="#00000000"
                    android:pathData="M54,34 A20,20 0 1,1 53.99,34 Z" />
            </group>

            <group
                android:name="wave2Group"
                android:pivotX="54.0"
                android:pivotY="54.0">
                <path
                    android:strokeColor="#00E5FF"
                    android:strokeWidth="2"
                    android:strokeAlpha="0.6"
                    android:fillColor="#00000000"
                    android:pathData="M54,24 A30,30 0 1,1 53.99,24 Z" />
            </group>

            <group
                android:name="wave3Group"
                android:pivotX="54.0"
                android:pivotY="54.0">
                <path
                    android:strokeColor="#00E5FF"
                    android:strokeWidth="2"
                    android:strokeAlpha="0.4"
                    android:fillColor="#00000000"
                    android:pathData="M54,14 A40,40 0 1,1 53.99,14 Z" />
            </group>

            <!-- Energy particles -->
            <group android:name="particles1">
                <path
                    android:fillColor="#FFD700"
                    android:pathData="M30,30 A2,2 0 1,1 29.99,30 Z" />
                <path
                    android:fillColor="#FFD700"
                    android:pathData="M78,30 A2,2 0 1,1 77.99,30 Z" />
                <path
                    android:fillColor="#FFD700"
                    android:pathData="M30,78 A2,2 0 1,1 29.99,78 Z" />
                <path
                    android:fillColor="#FFD700"
                    android:pathData="M78,78 A2,2 0 1,1 77.99,78 Z" />
            </group>

            <!-- MPEI text (modern font style) -->
            <group android:name="textGroup">
                <path
                    android:fillColor="#FFFFFF"
                    android:fillAlpha="0.95"
                    android:pathData="M 35,92 L 35,86 L 37.5,89 L 40,86 L 42.5,89 L 45,86 L 45,92 L 42.5,92 L 42.5,88.5 L 40,91 L 37.5,88.5 L 37.5,92 Z
                               M 48,92 L 48,86 L 53,86 L 53,88 L 50.5,88 L 50.5,88.5 L 52.5,88.5 L 52.5,90 L 50.5,90 L 50.5,92 Z
                               M 55,92 L 55,86 L 60,86 L 60,88 L 57.5,88 L 57.5,88.5 L 59.5,88.5 L 59.5,90 L 57.5,90 L 57.5,90.5 L 60,90.5 L 60,92 Z
                               M 62,92 L 62,86 L 64.5,86 L 64.5,92 Z" />
            </group>

            <!-- Subtle grid background for tech feel -->
            <group
                android:name="gridGroup"
                android:alpha="0.15">
                <!-- Horizontal lines -->
                <path
                    android:strokeColor="#FFFFFF"
                    android:strokeWidth="0.5"
                    android:pathData="M10,27 L98,27" />
                <path
                    android:strokeColor="#FFFFFF"
                    android:strokeWidth="0.5"
                    android:pathData="M10,54 L98,54" />
                <path
                    android:strokeColor="#FFFFFF"
                    android:strokeWidth="0.5"
                    android:pathData="M10,81 L98,81" />
                <!-- Vertical lines -->
                <path
                    android:strokeColor="#FFFFFF"
                    android:strokeWidth="0.5"
                    android:pathData="M27,10 L27,98" />
                <path
                    android:strokeColor="#FFFFFF"
                    android:strokeWidth="0.5"
                    android:pathData="M54,10 L54,98" />
                <path
                    android:strokeColor="#FFFFFF"
                    android:strokeWidth="0.5"
                    android:pathData="M81,10 L81,98" />
            </group>
        </vector>
    </aapt:attr>

    <!-- Lightning flash effect -->
    <target android:name="lightningGroup">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <!-- Flash on -->
                <objectAnimator
                    android:duration="100"
                    android:propertyName="alpha"
                    android:valueFrom="1.0"
                    android:valueTo="0.3" />
                <!-- Flash off -->
                <objectAnimator
                    android:duration="100"
                    android:propertyName="alpha"
                    android:valueFrom="0.3"
                    android:valueTo="1.0" />
                <!-- Pause -->
                <objectAnimator
                    android:duration="400"
                    android:propertyName="alpha"
                    android:valueFrom="1.0"
                    android:valueTo="1.0" />
                <!-- Flash on again -->
                <objectAnimator
                    android:duration="100"
                    android:propertyName="alpha"
                    android:valueFrom="1.0"
                    android:valueTo="0.3" />
                <!-- Flash off -->
                <objectAnimator
                    android:duration="100"
                    android:propertyName="alpha"
                    android:valueFrom="0.3"
                    android:valueTo="1.0" />
            </set>
        </aapt:attr>
    </target>

    <!-- Wave 1 expansion -->
    <target android:name="wave1Group">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="0"
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="0" />
                <objectAnimator
                    android:duration="1000"
                    android:propertyName="scaleX"
                    android:valueFrom="0.5"
                    android:valueTo="1.5"
                    android:repeatCount="infinite"
                    android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
    
    <target android:name="wave1Group">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="0"
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="0" />
                <objectAnimator
                    android:duration="1000"
                    android:propertyName="scaleY"
                    android:valueFrom="0.5"
                    android:valueTo="1.5"
                    android:repeatCount="infinite"
                    android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <!-- Wave 2 expansion (delayed) -->
    <target android:name="wave2Group">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="200"
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="0" />
                <objectAnimator
                    android:duration="1000"
                    android:propertyName="scaleX"
                    android:valueFrom="0.5"
                    android:valueTo="1.5"
                    android:repeatCount="infinite"
                    android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
    
    <target android:name="wave2Group">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="200"
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="0" />
                <objectAnimator
                    android:duration="1000"
                    android:propertyName="scaleY"
                    android:valueFrom="0.5"
                    android:valueTo="1.5"
                    android:repeatCount="infinite"
                    android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <!-- Wave 3 expansion (more delayed) -->
    <target android:name="wave3Group">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="400"
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="0" />
                <objectAnimator
                    android:duration="1000"
                    android:propertyName="scaleX"
                    android:valueFrom="0.5"
                    android:valueTo="1.5"
                    android:repeatCount="infinite"
                    android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
    
    <target android:name="wave3Group">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="400"
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="0" />
                <objectAnimator
                    android:duration="1000"
                    android:propertyName="scaleY"
                    android:valueFrom="0.5"
                    android:valueTo="1.5"
                    android:repeatCount="infinite"
                    android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <!-- Particles floating -->
    <target android:name="particles1">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="1500"
                    android:propertyName="translateY"
                    android:valueFrom="0"
                    android:valueTo="-10"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <!-- Text fade in -->
    <target android:name="textGroup">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="300"
                    android:propertyName="alpha"
                    android:valueFrom="0"
                    android:valueTo="0" />
                <objectAnimator
                    android:duration="400"
                    android:propertyName="alpha"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:interpolator="@android:anim/accelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
