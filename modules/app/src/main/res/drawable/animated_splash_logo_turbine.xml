<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">

            <!-- Gradient background -->
            <path
                android:fillColor="#001F3F"
                android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />

            <!-- Outer ring (turbine housing) -->
            <path
                android:strokeColor="#2A9FD6"
                android:strokeWidth="3"
                android:fillColor="#00000000"
                android:pathData="M54,10 A44,44 0 1,1 53.99,10 Z" />
            
            <!-- Inner ring -->
            <path
                android:strokeColor="#2A9FD6"
                android:strokeWidth="2"
                android:strokeAlpha="0.6"
                android:fillColor="#00000000"
                android:pathData="M54,18 A36,36 0 1,1 53.99,18 Z" />

            <!-- Rotating turbine blades -->
            <group
                android:name="turbineGroup"
                android:pivotX="54.0"
                android:pivotY="54.0">
                
                <!-- Blade 1 (top) -->
                <path
                    android:fillColor="#00D9FF"
                    android:pathData="M54,28 L58,38 L54,44 L50,38 Z" />
                <path
                    android:fillColor="#0099CC"
                    android:pathData="M54,44 L58,38 L60,42 L56,48 Z" />
                
                <!-- Blade 2 (right) -->
                <path
                    android:fillColor="#00D9FF"
                    android:pathData="M80,54 L70,58 L64,54 L70,50 Z" />
                <path
                    android:fillColor="#0099CC"
                    android:pathData="M64,54 L70,58 L66,60 L60,56 Z" />
                
                <!-- Blade 3 (bottom) -->
                <path
                    android:fillColor="#00D9FF"
                    android:pathData="M54,80 L50,70 L54,64 L58,70 Z" />
                <path
                    android:fillColor="#0099CC"
                    android:pathData="M54,64 L50,70 L48,66 L52,60 Z" />
                
                <!-- Blade 4 (left) -->
                <path
                    android:fillColor="#00D9FF"
                    android:pathData="M28,54 L38,50 L44,54 L38,58 Z" />
                <path
                    android:fillColor="#0099CC"
                    android:pathData="M44,54 L38,50 L42,48 L48,52 Z" />
                
                <!-- Blade 5 (top-right) -->
                <path
                    android:fillColor="#00D9FF"
                    android:pathData="M69,35 L66,44 L60,42 L63,33 Z" />
                
                <!-- Blade 6 (bottom-right) -->
                <path
                    android:fillColor="#00D9FF"
                    android:pathData="M69,73 L63,75 L60,66 L66,64 Z" />
                
                <!-- Blade 7 (bottom-left) -->
                <path
                    android:fillColor="#00D9FF"
                    android:pathData="M39,73 L45,75 L48,66 L42,64 Z" />
                
                <!-- Blade 8 (top-left) -->
                <path
                    android:fillColor="#00D9FF"
                    android:pathData="M39,35 L42,44 L48,42 L45,33 Z" />
            </group>

            <!-- Central core (generator) -->
            <group android:name="coreGroup">
                <!-- Outer core -->
                <path
                    android:fillColor="#FF6B35"
                    android:pathData="M54,46 A8,8 0 1,1 53.99,46 Z" />
                
                <!-- Inner core glow -->
                <path
                    android:fillColor="#FFAD5A"
                    android:pathData="M54,49 A5,5 0 1,1 53.99,49 Z" />
                
                <!-- Core highlight -->
                <path
                    android:fillColor="#FFFFFF"
                    android:fillAlpha="0.8"
                    android:pathData="M54,50 A4,4 0 1,1 53.99,50 Z" />
            </group>

            <!-- Energy flow lines (magnetic field) -->
            <group
                android:name="flowGroup"
                android:pivotX="54.0"
                android:pivotY="54.0">
                <!-- Top flow -->
                <path
                    android:strokeColor="#00FFB8"
                    android:strokeWidth="1.5"
                    android:fillColor="#00000000"
                    android:strokeLineCap="round"
                    android:pathData="M30,20 Q20,54 30,88" />
                <!-- Bottom flow -->
                <path
                    android:strokeColor="#00FFB8"
                    android:strokeWidth="1.5"
                    android:fillColor="#00000000"
                    android:strokeLineCap="round"
                    android:pathData="M78,20 Q88,54 78,88" />
            </group>

            <!-- Power indicator lights -->
            <group android:name="lights1">
                <path
                    android:fillColor="#00FF00"
                    android:pathData="M54,6 A2,2 0 1,1 53.99,6 Z" />
            </group>
            
            <group android:name="lights2">
                <path
                    android:fillColor="#00FF00"
                    android:pathData="M102,54 A2,2 0 1,1 101.99,54 Z" />
            </group>
            
            <group android:name="lights3">
                <path
                    android:fillColor="#00FF00"
                    android:pathData="M54,102 A2,2 0 1,1 53.99,102 Z" />
            </group>
            
            <group android:name="lights4">
                <path
                    android:fillColor="#00FF00"
                    android:pathData="M6,54 A2,2 0 1,1 5.99,54 Z" />
            </group>

            <!-- MPEI text with power symbol -->
            <group android:name="textGroup">
                <path
                    android:fillColor="#FFFFFF"
                    android:pathData="M 36,94 L 36,88 L 38.5,91 L 41,88 L 43.5,91 L 46,88 L 46,94 L 43.5,94 L 43.5,90.5 L 41,93 L 38.5,90.5 L 38.5,94 Z
                               M 49,94 L 49,88 L 54,88 L 54,90 L 51.5,90 L 51.5,90.5 L 53.5,90.5 L 53.5,92 L 51.5,92 L 51.5,94 Z
                               M 56,94 L 56,88 L 61,88 L 61,90 L 58.5,90 L 58.5,90.5 L 60.5,90.5 L 60.5,92 L 58.5,92 L 58.5,92.5 L 61,92.5 L 61,94 Z
                               M 63,94 L 63,88 L 65.5,88 L 65.5,94 Z" />
                
                <!-- Power symbol -->
                <path
                    android:fillColor="#00FF00"
                    android:pathData="M70,91 A2.5,2.5 0 1,1 69.99,91 Z
                               M70,88 L70,91" />
            </group>
        </vector>
    </aapt:attr>

    <!-- Turbine rotation (smooth, infinite) -->
    <target android:name="turbineGroup">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="2500"
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="360"
                android:repeatCount="infinite"
                android:interpolator="@android:anim/linear_interpolator" />
        </aapt:attr>
    </target>

    <!-- Core pulsing (power generation effect) -->
    <target android:name="coreGroup">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="800"
                    android:propertyName="scaleX"
                    android:valueFrom="1.0"
                    android:valueTo="1.2"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
    
    <target android:name="coreGroup">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="800"
                    android:propertyName="scaleY"
                    android:valueFrom="1.0"
                    android:valueTo="1.2"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <!-- Flow lines animation (energy flow) -->
    <target android:name="flowGroup">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="3000"
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="-360"
                android:repeatCount="infinite"
                android:interpolator="@android:anim/linear_interpolator" />
        </aapt:attr>
    </target>

    <!-- Indicator lights blinking pattern -->
    <target android:name="lights1">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="200"
                    android:propertyName="alpha"
                    android:valueFrom="1.0"
                    android:valueTo="0.3"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse" />
            </set>
        </aapt:attr>
    </target>
    
    <target android:name="lights2">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:startOffset="100"
                    android:duration="200"
                    android:propertyName="alpha"
                    android:valueFrom="1.0"
                    android:valueTo="0.3"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse" />
            </set>
        </aapt:attr>
    </target>
    
    <target android:name="lights3">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:startOffset="200"
                    android:duration="200"
                    android:propertyName="alpha"
                    android:valueFrom="1.0"
                    android:valueTo="0.3"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse" />
            </set>
        </aapt:attr>
    </target>
    
    <target android:name="lights4">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:startOffset="300"
                    android:duration="200"
                    android:propertyName="alpha"
                    android:valueFrom="1.0"
                    android:valueTo="0.3"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse" />
            </set>
        </aapt:attr>
    </target>

    <!-- Text fade in -->
    <target android:name="textGroup">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="500"
                    android:propertyName="alpha"
                    android:valueFrom="0"
                    android:valueTo="0" />
                <objectAnimator
                    android:duration="600"
                    android:propertyName="alpha"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:interpolator="@android:anim/accelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
