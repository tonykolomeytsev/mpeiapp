<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Plain black system splash (no white flash in any theme).
        The animated МЭИ.Хаб splash is drawn by SplashOverlay (:ui_splash) on top of the main screen.
    -->
    <style name="Theme.Mpeix.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/colorBlack</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
