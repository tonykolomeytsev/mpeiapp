<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/mapCoordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context="kekmech.ru.feature_map_impl.presentation.screen.main.MapFragment">

    <LinearLayout
            android:id="@+id/placeDescriptionLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:gravity="center_horizontal"
            android:orientation="vertical">

        <TextView
                android:id="@+id/textViewPlaceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        <TextView
                android:id="@+id/textViewPlaceAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

    </LinearLayout>

    <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    <View
            android:id="@+id/viewFade"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="?attr/colorWhite"
            tools:alpha="0.5" />

    <LinearLayout
            android:id="@+id/mapOverlayControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp">

        <TextView
                android:id="@+id/mapCopyright"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#99000000"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:visibility="gone"
                tools:text="© Esri, Maxar, Earthstar Geographics"
                tools:visibility="visible" />

        <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/mapAppearanceToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:checkedButton="@+id/mapAppearanceScheme"
                app:selectionRequired="true"
                app:singleSelection="true">

            <Button
                    android:id="@+id/mapAppearanceScheme"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="?attr/colorWhite"
                    android:text="@string/change_map_type_scheme"
                    android:textColor="?android:attr/textColorPrimary" />

            <Button
                    android:id="@+id/mapAppearanceHybrid"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="?attr/colorWhite"
                    android:text="@string/change_map_type_hybrid"
                    android:textColor="?android:attr/textColorPrimary" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/coordinatorLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="@dimen/tablet_frame_width"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/background_bottom_sheet"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="8dp"
                app:behavior_hideable="false"
                app:behavior_peekHeight="120dp"
                app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
                tools:layout_height="200dp" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</FrameLayout>
