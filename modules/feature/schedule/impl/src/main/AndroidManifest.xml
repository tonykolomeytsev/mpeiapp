<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permission for notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Class reminders: alarms are lost after a reboot and have to be registered again -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        Exact alarms (Android 12+). Without the permission the reminders are registered as inexact alarms,
        the settings screen offers the user to grant it.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application>
        <receiver
            android:name="kekmech.ru.feature_schedule_impl.notifications.reminders.ClassReminderReceiver"
            android:exported="false" />

        <receiver
            android:name="kekmech.ru.feature_schedule_impl.notifications.lockscreen.LockScreenReceiver"
            android:exported="false" />

        <receiver
            android:name="kekmech.ru.feature_schedule_impl.notifications.reminders.ClassReminderSystemReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="kekmech.ru.feature_schedule_impl.presentation.widget.ScheduleGlanceWidgetReceiver"
            android:label="@string/schedule_widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info" />
        </receiver>

        <receiver
            android:name="kekmech.ru.feature_schedule_impl.presentation.widget.ScheduleGlanceWidgetCompactReceiver"
            android:label="@string/schedule_widget_name_compact"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info_compact" />
        </receiver>

        <receiver
            android:name="kekmech.ru.feature_schedule_impl.presentation.widget.ScheduleGlanceWidgetSquareReceiver"
            android:label="@string/schedule_widget_name_square"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info_square" />
        </receiver>

        <receiver
            android:name="kekmech.ru.feature_schedule_impl.presentation.widget.ScheduleGlanceWidgetLargeReceiver"
            android:label="@string/schedule_widget_name_large"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info_large" />
        </receiver>
    </application>

</manifest>
